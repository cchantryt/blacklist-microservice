
{
  "family": "blacklist-microservice-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::196659290533:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::196659290533:role/blacklistEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "blacklist-container",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DB_SECRET_ARN",
          "value": "arn:aws:secretsmanager:us-east-2:196659290533:secret:blacklist/database-W0848O"
        },
        {
          "name": "JWT_SECRET_ARN",
          "value": "arn:aws:secretsmanager:us-east-2:196659290533:secret:blacklist/jwt-mUOGsl"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blacklist-microservice",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
